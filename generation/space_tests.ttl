  bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if either of the terms dwc:country or dwc:countryCode are bdqval:Empty; COMPLIANT if the values of dwc:country and dwc:countryCode match national-level country name and matching country code respectively in the bdqval:sourceAuthority";
  rdfs:label "Specification for: VALIDATION_COUNTRYCOUNTRYCODE_CONSISTENT";
  dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if either of the terms dwc:country or dwc:countryCode are bdqval:Empty; COMPLIANT if the values of dwc:country and dwc:countryCode match national-level country name and matching country code respectively in the bdqval:sourceAuthority bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}" .

bdqtest:2d638c8b-4c62-44a0-a14d-fa147bf9823d-2025-03-07 a bdqffdq:Amendment;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  bdqffdq:hasEnhancement bdqenh:FilledInFrom;
  skos:note "If the dwc:verbatimElevation as a single value rather than a range, the minimum and maximum values should be amended with the same value. When transforming units, the transformation should be reversible, not adjusting the number of significant digits or adjusting the rounding. For example, transform yards to meters by multiplying by 0.9144 and retaining added significant digits (verbatim elevation of 10 yards to minimum and maximum depths in meters of 9.144). Implementations should be capable of interpreting verbatim data in at least meters,yards, feet, and kilometers in the form of either a single value or a range. The units must be specified in the verbatim data to be interpretable.";
  bdqffdq:hasDataQualityDimension bdqdim:Completeness;
  dcterms:description "Proposes an amendment or amendments to the values of dwc:minimumElevationInMeters and dwc:maximumElevationInMeters if they can be interpreted from dwc:verbatimElevation.";
  bdqffdq:hasActedUponInformationElement <urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f>;
  bdqffdq:hasConsultedInformationElement <urn:uuid:0c598386-f49e-40b3-bbcc-b217e7d2b449>;
  dcterms:issued "2025-03-07"^^xsd:date;
  dcterms:references <urn:uuid:d88b7236-01d3-4640-8979-c9e7638d2cbb>;
  skos:historyNote "https://github.com/tdwg/bdq/issues/68";
  rdfs:label "AMENDMENT_MINELEVATIONMAXELEVATION_FROM_VERBATIM";
  dcterms:isVersionOf bdqtest:2d638c8b-4c62-44a0-a14d-fa147bf9823d;
  skos:prefLabel "Amendment dwc:minimumElevationInMeters dwc:maximumElevationInMeters from dwc:verbatimElevation for SingleRecord" .

<urn:uuid:3d5994c8-29df-4399-965c-c2c596a6767f> a bdqffdq:ActedUpon;
  bdqffdq:composedOf dwc:minimumElevationInMeters, dwc:maximumElevationInMeters;
  rdfs:label "Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters";
  skos:prefLabel "Information Element ActedUpon dwc:minimumElevationInMeters, dwc:maximumElevationInMeters" .

<urn:uuid:0c598386-f49e-40b3-bbcc-b217e7d2b449> a bdqffdq:Consulted;
  bdqffdq:composedOf dwc:verbatimElevation;
  rdfs:label "Information Element Consulted dwc:verbatimElevation";
  skos:prefLabel "Information Element Consulted dwc:verbatimElevation" .

