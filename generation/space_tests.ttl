<urn:uuid:f93ba397-7bdf-4cb0-836b-467bc2a8a9f8> a bdqffdq:ValidationMethod;
  skos:note "Example Implementations: Kurator/FilteredPush geo_ref_qc Library  DOI: [10.5281/zenodo.14064324](https://doi.org/10.5281/zenodo.14064324)",
    "Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/d0746151fd84c0310b5ac2a17a2e0cd249ad6b8c/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L2893",
    "TG2 Validation SPACE CODED Test VOCABULARY Supplementary Consistency Parameterized";
  bdqffdq:hasSpecification <urn:uuid:39cbb213-b33a-4e45-bfa4-967ee277455b>;
  skos:historyNote "Source: VertNet, Kurator";
  rdfs:label "ValidationMethod: VALIDATION_COUNTRYSTATEPROVINCE_CONSISTENT with Specification for: VALIDATION_COUNTRYSTATEPROVINCE_CONSISTENT";
  skos:prefLabel "ValidationMethod: VALIDATION_COUNTRYSTATEPROVINCE_CONSISTENT with Specification for: VALIDATION_COUNTRYSTATEPROVINCE_CONSISTENT";
  bdqffdq:forValidation bdqtest:e654f562-44f8-43fd-983b-2aaba4c6dda9-2025-03-05 .

<urn:uuid:39cbb213-b33a-4e45-bfa4-967ee277455b> a bdqffdq:Specification;
  skos:example "dwc:country=\"Australia\", dwc:stateProvince=\"WA\": Response.status=RUN_HAS_RESULT, Response.result=COMPLIANT, Response.comment=\"dwc:country is consistent with dwc:stateProvince. dwc:stateProvince matches Western Australia in dwc:country Australia\"",
    "dwc:country=\"Australia\", dwc:stateProvince=\"Florida\": Response.status=RUN_HAS_RESULT, Response.result=NOT_COMPLIANT, Response.comment=\"dwc:country is not consistent with dwc:stateProvince\"";
  bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}";
  bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the terms dwc:country or dwc:stateProvince are bdqval:Empty; COMPLIANT if the value of dwc:stateProvince occurs as an administrative entity that is a child to the administrative entity matching the value of dwc:country in the bdqval:sourceAuthority, and the match to dwc:country is an ISO 3166 country-like administrative entity in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT";
  rdfs:label "Specification for: VALIDATION_COUNTRYSTATEPROVINCE_CONSISTENT";
  dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the terms dwc:country or dwc:stateProvince are bdqval:Empty; COMPLIANT if the value of dwc:stateProvince occurs as an administrative entity that is a child to the administrative entity matching the value of dwc:country in the bdqval:sourceAuthority, and the match to dwc:country is an ISO 3166 country-like administrative entity in the bdqval:sourceAuthority; otherwise NOT_COMPLIANT bdqval:sourceAuthority default = \"The Getty Thesaurus of Geographic Names (TGN)\" {[https://www.getty.edu/research/tools/vocabularies/tgn/index.html]}";
  bdqffdq:hasArgument <urn:uuid:7ccbc893-d9cf-4dbd-861a-c7d88702de43> .

<urn:uuid:7ccbc893-d9cf-4dbd-861a-c7d88702de43> a bdqffdq:Argument;
  bdqffdq:hasArgumentValue "The Getty Thesaurus of Geographic Names (TGN)";
  rdfs:label "Default value for bdqval:sourceAuthority:\"The Getty Thesaurus of Geographic Names (TGN)\"";
  bdqffdq:hasParameter bdqval:sourceAuthority .

