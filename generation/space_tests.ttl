<urn:uuid:84195393-4797-465f-bfc1-b764df67c5c2> a bdqffdq:Specification;
  skos:example "dwc:verbatimElevation=\"100 feet\", dwc:minimumElevationInMeters=\"\", dwc:maximumElevationInMeters=\"\": Response.status=FILLED_IN, Response.result=dwc:minimumElevationInMeters=\"30.48\", dwc:maximumElevationInMeters=\"30.48\", Response.comment=\"dwc:verbatimElevation contains an interpretable value\"",
    "dwc:verbatimElevation=\"x\", dwc:minimumElevationInMeters=\"\", dwc:maximumElevationInMeters=\"\": Response.status=NOT_AMENDED, Response.result=\"\", Response.comment=\"dwc:verbatimElevation contains an uninterpretable value\"";
  bdqffdq:hasAuthoritiesDefaults "";
  bdqffdq:hasExpectedResponse "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumElevationInMeters or dwc:maximumElevationInMeters are bdqval:NotEmpty or dwc:verbatimElevation is bdqval:Empty; FILLED_IN the values of dwc:minimumElevationInMeters and dwc:maximumElevationInMeters if they can be unambiguously interpreted from dwc:verbatimElevation; otherwise NOT_AMENDED";
  rdfs:label "Specification for: AMENDMENT_MINELEVATIONMAXELEVATION_FROM_VERBATIM";
  dcterms:description "INTERNAL_PREREQUISITES_NOT_MET if dwc:minimumElevationInMeters or dwc:maximumElevationInMeters are bdqval:NotEmpty or dwc:verbatimElevation is bdqval:Empty; FILLED_IN the values of dwc:minimumElevationInMeters and dwc:maximumElevationInMeters if they can be unambiguously interpreted from dwc:verbatimElevation; otherwise NOT_AMENDED" .

bdqtest:8c5fe9c9-4ba9-49ef-b15a-9ccd0424e6ae-2025-03-07 a bdqffdq:Amendment;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  bdqffdq:hasEnhancement bdqenh:FilledInFrom;
  skos:note "This amendment simply fills dwc:countryCode from a lookup of dwc:decimalLatitude and dwc:decimalLongitude.  If the coordinate falls in the high seas outside any national jurisdiction dwc:countryCode=\"XZ\" should be asserted.  Values in dwc:coordinateUncertaintyInMeters and dwc:coordinatePrecision (if present) imply a buffer around the provided coordinates. Likewise, country polygons cannot be 100% accurate at all scales (Dooley 2005), so a spatial buffer of the country boundaries is also justified. Taking spatial buffers into account does, however, greatly complicate the logic and the implementation of this and related Tests. In this Test, a detection of multiple country codes by sampling within the buffer, while possible, is not considered.";
  bdqffdq:hasDataQualityDimension bdqdim:Completeness;
  dcterms:description "Proposes an amendment to the value of dwc:countryCode if dwc:decimalLatitude and dwc:decimalLongitude fall within a boundary from the bdqval:countryShapes that is attributable to a single valid ISO 3166-1-alpha-2 country code.";
  bdqffdq:hasActedUponInformationElement <urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423>;
  bdqffdq:hasConsultedInformationElement <urn:uuid:c3849b5d-feb7-4388-ab95-ec54ff1031ea>;
  dcterms:issued "2025-03-07"^^xsd:date;
  dcterms:references <urn:uuid:d88b7236-01d3-4640-8979-c9e7638d2cbb>, <urn:uuid:95c9d062-c0d8-4fbb-a049-ff3ba89136cb>,
    <urn:uuid:659f4f43-ef7d-4c48-917c-7d5b16655bfe>, <urn:uuid:a2ba8081-1397-42c9-92ad-e396238332b4>,
    <urn:uuid:547a3487-f597-4d64-bbd5-57718c94ec53>, <urn:uuid:65638c00-c42f-4aa3-a641-d746df21e940>,
    <urn:uuid:1fa0f884-feeb-4c46-a500-8e297417408c>, <urn:uuid:95fc2b8b-5647-4170-81f9-18a03a34ba4a>;
  skos:historyNote "https://github.com/tdwg/bdq/issues/73";
  rdfs:label "AMENDMENT_COUNTRYCODE_FROM_COORDINATES";
  dcterms:isVersionOf bdqtest:8c5fe9c9-4ba9-49ef-b15a-9ccd0424e6ae;
  skos:prefLabel "Amendment dwc:countryCode from Coordinates for SingleRecord" .

<urn:uuid:c3849b5d-feb7-4388-ab95-ec54ff1031ea> a bdqffdq:Consulted;
  bdqffdq:composedOf dwc:decimalLatitude, dwc:decimalLongitude;
  rdfs:label "Information Element Consulted dwc:decimalLatitude, dwc:decimalLongitude";
  skos:prefLabel "Information Element Consulted dwc:decimalLatitude, dwc:decimalLongitude" .

<urn:uuid:95c9d062-c0d8-4fbb-a049-ff3ba89136cb> a dcterms:BibliographicResource;
  dcterms:bibliographicCitation "VLIZ (2023) Marineregions.org. https://www.marineregions.org/downloads.php#marbound" .

<urn:uuid:5e55d983-5667-438c-9754-a71dfe2472af> a bdqffdq:AmendmentMethod;
  skos:note "Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris & Lowery 2025b)",
    "Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.1.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L2019",
    "TG2 Amendment SPACE CODED Test VOCABULARY Completeness ISO/DCMI STANDARD Parameterized CORE";
  bdqffdq:forAmendment bdqtest:8c5fe9c9-4ba9-49ef-b15a-9ccd0424e6ae-2025-03-07;
  bdqffdq:hasSpecification <urn:uuid:95ac057e-a941-416f-b7dc-ad7aca875cff>;
  skos:historyNote "Source: ALA, GBIF, iDigBio";
  rdfs:label "AmendmentMethod: AMENDMENT_COUNTRYCODE_FROM_COORDINATES with Specification Specification for: AMENDMENT_COUNTRYCODE_FROM_COORDINATES";
  skos:prefLabel "AmendmentMethod: AMENDMENT_COUNTRYCODE_FROM_COORDINATES with Specification Specification for: AMENDMENT_COUNTRYCODE_FROM_COORDINATES" .

<urn:uuid:95ac057e-a941-416f-b7dc-ad7aca875cff> a bdqffdq:Specification;
  skos:example "dwc:decimalLatitude=\"-25.23\", dwc:decimalLongitude=\"135.43\", dwc:countryCode=\"\": Response.status=FILLED_IN, Response.result=dwc:countryCode=\"AU\", Response.comment=\"dwc:decimalLatitude and dwc:decimalLongitude contain interpretable values\"",
    "dwc:decimalLatitude=\"-38.280937\", dwc:decimalLongitude=\"72.047790\", dwc:countryCode=\"\": Response.status=FILLED_IN, Response.result=dwc:countryCode=\"XZ\", Response.comment=\"Coordinates do not fall in the boundary of any national jurisdiction, using XZ for high seas\"";
  bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]}";
  bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if either dwc:decimalLatitude or dwc:decimalLongitude is bdqval:Empty, or if dwc:countryCode is bdqval:NotEmpty; FILLED_IN dwc:countryCode if dwc:decimalLatitude and dwc:decimalLongitude fall within a boundary in the bdqval:sourceAuthority that is attributable to a single valid country code; otherwise NOT_AMENDED.";
  rdfs:label "Specification for: AMENDMENT_COUNTRYCODE_FROM_COORDINATES";
  dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if either dwc:decimalLatitude or dwc:decimalLongitude is bdqval:Empty, or if dwc:countryCode is bdqval:NotEmpty; FILLED_IN dwc:countryCode if dwc:decimalLatitude and dwc:decimalLongitude fall within a boundary in the bdqval:sourceAuthority that is attributable to a single valid country code; otherwise NOT_AMENDED. bdqval:sourceAuthority default = \"10m-admin-1 boundaries UNION with Exclusive Economic Zones\" {[https://www.naturalearthdata.com/downloads/10m-cultural-vectors/10m-admin-1-states-provinces/] spatial UNION [https://www.marineregions.org/downloads.php#marbound]}";
  bdqffdq:hasArgument <urn:uuid:82350b56-1855-4b5a-8b44-9040efb0bf05> .

<urn:uuid:82350b56-1855-4b5a-8b44-9040efb0bf05> a bdqffdq:Argument;
  bdqffdq:hasArgumentValue "10m-admin-1 boundaries UNION with Exclusive Economic Zones";
  rdfs:label "Default value for bdqval:sourceAuthority:\"10m-admin-1 boundaries UNION with Exclusive Economic Zones\"";
  bdqffdq:hasParameter bdqval:sourceAuthority .

