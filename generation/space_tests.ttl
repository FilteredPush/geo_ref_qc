bdqtest:fec5ffe6-3958-4312-82d9-ebcca0efb350-2025-03-07 a bdqffdq:Amendment;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  bdqffdq:hasEnhancement bdqenh:Standardized;
  skos:note "This Test supports conformance with the recommendation in the comment on dwc:countryCode: \"Recommended best practice is to use an ISO 3166-1-alpha-2 country code.\" Darwin Core also recommends the use of the XZ for high seas and ZZ for unknown. Three letter codes should be amended to the matching two-letter code.";
  bdqffdq:hasDataQualityDimension bdqdim:Conformance;
  dcterms:description "Proposes an amendment to the value of dwc:countryCode if it can be interpreted as an ISO 3166-1-alpha-2 country code.";
  bdqffdq:hasActedUponInformationElement <urn:uuid:c3620a97-65d6-4f9c-8a03-32e0d240a423>;
  dcterms:issued "2025-03-07"^^xsd:date;
  dcterms:references <urn:uuid:70ca162c-3be5-47d1-92ff-6bf654932d58>, <urn:uuid:a2ba8081-1397-42c9-92ad-e396238332b4>,
    <urn:uuid:547a3487-f597-4d64-bbd5-57718c94ec53>, <urn:uuid:d88b7236-01d3-4640-8979-c9e7638d2cbb>;
  skos:historyNote "https://github.com/tdwg/bdq/issues/48";
  rdfs:label "AMENDMENT_COUNTRYCODE_STANDARDIZED";
  dcterms:isVersionOf bdqtest:fec5ffe6-3958-4312-82d9-ebcca0efb350;
  skos:prefLabel "Amendment dwc:countryCode Standard for SingleRecord" .

bdqenh:Standardized a bdqffdq:Enhancement;
  rdfs:label "Standardized" .

<urn:uuid:a2ba8081-1397-42c9-92ad-e396238332b4> a dcterms:BibliographicResource;
  dcterms:bibliographicCitation "Wikipedia (2020) ISO 3166-1 alpha-2. https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2" .

<urn:uuid:29b2e2ac-9667-4774-ac06-45333555c620> a bdqffdq:AmendmentMethod;
  skos:note "Example Implementations: Kurator/FilteredPush geo_ref_qc Library (Morris & Lowery 2025b)",
    "Example Implementations Source Code: https://github.com/FilteredPush/geo_ref_qc/blob/v2.0.1/src/main/java/org/filteredpush/qc/georeference/DwCGeoRefDQ.java#L931",
    "TG2 Amendment SPACE CODED Test VOCABULARY Conformance ISO/DCMI STANDARD CORE";
  bdqffdq:forAmendment bdqtest:fec5ffe6-3958-4312-82d9-ebcca0efb350-2025-03-07;
  bdqffdq:hasSpecification <urn:uuid:3e076cfa-56ff-4b79-9739-736d062eac5a>;
  rdfs:label "AmendmentMethod: AMENDMENT_COUNTRYCODE_STANDARDIZED with Specification Specification for: AMENDMENT_COUNTRYCODE_STANDARDIZED";
  skos:prefLabel "AmendmentMethod: AMENDMENT_COUNTRYCODE_STANDARDIZED with Specification Specification for: AMENDMENT_COUNTRYCODE_STANDARDIZED" .

<urn:uuid:3e076cfa-56ff-4b79-9739-736d062eac5a> a bdqffdq:Specification;
  skos:example "dwc:countryCode=\"Australia\": Response.status=AMENDED, Response.result=dwc:countryCode=\"AU\", Response.comment=\"dwc:countryCode contains an interpretable value\"",
    "dwc:countryCode=\"Aust.\": Response.status=NOT_AMENDED, Response.result=, Response.comment=\"dwc:countryCode contains an ambiguous value\"";
  bdqffdq:hasAuthoritiesDefaults "bdqval:sourceAuthority default = \"ISO 3166-1-alpha-2\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}";
  bdqffdq:hasExpectedResponse "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dwc:countryCode is bdqval:Empty; AMENDED the value of dwc:countryCode if it can be unambiguously interpreted to a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED";
  rdfs:label "Specification for: AMENDMENT_COUNTRYCODE_STANDARDIZED";
  dcterms:description "EXTERNAL_PREREQUISITES_NOT_MET if the bdqval:sourceAuthority is not available; INTERNAL_PREREQUISITES_NOT_MET if the value of dwc:countryCode is bdqval:Empty; AMENDED the value of dwc:countryCode if it can be unambiguously interpreted to a value in the bdqval:sourceAuthority; otherwise NOT_AMENDED bdqval:sourceAuthority default = \"ISO 3166-1-alpha-2\" {[https://www.iso.org/iso-3166-country-codes.html]} {ISO 3166-1-alpha-2 Country Code search [https://www.iso.org/obp/ui/#search]}" .

bdqtest:adb27d29-9f0d-4d52-b760-a77ba57a69c9-2025-03-07 a bdqffdq:Validation;
  bdqffdq:hasResourceType bdqffdq:SingleRecord;
  skos:note "dwc:coordinatePrecision and dwc:coordinateUncertaintyInMeters (if present) imply a potential displacement of the provided coordinates. These two terms can be considered spatial buffers. Likewise, country polygons cannot be 100% accurate at all scales (Dooley 2005), so a spatial buffer of the country boundaries is justified. When dwc:countryCode=XZ (for High Seas), the coordinate should fall into a marine region out side of the EEZ of any country. Taking the spatial buffers into account does however greatly complicate both the logic and the implementation of such Tests. The same applies to potential conversion of the Spatial Reference System (SRS) of dwc:decimalLatitude and dwc:decimalLongitude to the SRS used in the bdqval:sourceAuthority.";
  bdqffdq:hasDataQualityDimension bdqdim:Consistency;
  dcterms:description "Do the geographic coordinates fall on or within the boundaries of the territory given in dwc:countryCode or its Exclusive Economic Zone?";
  bdqffdq:hasCriterion bdqcrit:Consistent;
